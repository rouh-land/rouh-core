An app's code is a git repository with rouh-app.json at its top:
  {"kind": "python", "start": "gunicorn -b 127.0.0.1:$PORT app:app", "migrate": "", "health": "/healthz",
   "memory": "512M", "database": true}
  start     the command that runs it; it must listen on 127.0.0.1:$PORT.
  migrate   run once per release, before the test copy starts (empty for none).
  health    a path that answers 200 when the app is well; checked for 30 seconds after every start.
  memory    its limit (MemoryMax); a --memory given to new wins.
  root      for static sites only: the folder inside the code to serve, like dist.
Python apps pin every package in requirements.txt (name==version); each release gets its own virtual
environment. A static site needs no rouh-app.json: its files are served as they are.

Every app gets in its environment:
  PORT          where to listen, on 127.0.0.1 (the test copy has its own)
  DATABASE_URL  postgresql://app_NAME:...@127.0.0.1:5432/app_NAME, when it has a database
  APP_NAME      its name
  APP_URL       its own https address (the test copy's own address in the test copy)
  APP_SLOT      live or test
  and every KEY=value in /srv/apps/NAME/shared/.env, which is kept across releases.
Only /srv/apps/NAME/shared is writable by the app: keep uploads there.

Where things are:
  /srv/apps/NAME/releases/STAMP-SHA, live and test (links), shared/, backups/, repo.git
  /etc/rouh-apps/apps/NAME.json     the app's record
  /etc/caddy/apps/NAME.caddy        its addresses
  app-NAME.service, app-NAME-test.service    journalctl -u app-NAME for its log
"""


def cmd_help(a):
    sys.stdout.write(HELP)


def parser():
    p = argparse.ArgumentParser(prog="rouh-app", add_help=False)
    sub = p.add_subparsers(dest="verb")

    def verb(name, func, with_name=True):
        s = sub.add_parser(name, add_help=False)
        if with_name:
            s.add_argument("name")
        s.set_defaults(func=func)
        return s

    s = verb("new", cmd_new)
    s.add_argument("--kind", choices=KINDS)
    s.add_argument("--repo")
    s.add_argument("--branch")
    s.add_argument("--domain")
    s.add_argument("--memory")
    s.add_argument("--database")
    s = verb("deploy", cmd_deploy)
    s.add_argument("--ref")
    verb("update", cmd_update)
    verb("rollback", cmd_rollback)
    verb("restart", cmd_restart)
    s = verb("logs", cmd_logs)
    s.add_argument("--lines", type=int, default=200)
    verb("backup", cmd_backup)
    verb("restore-test", cmd_restore_test)
    verb("backup-all", cmd_backup_all, with_name=False)
    s = verb("status", cmd_status, with_name=False)
    s.add_argument("--json", action="store_true")
    verb("list", cmd_list, with_name=False)
    s = verb("remove", cmd_remove)
    s.add_argument("--yes", action="store_true")
    s.add_argument("--drop-database", action="store_true")
    verb("help", cmd_help, with_name=False)
    return p


def main(argv):
    p = parser()
    if not argv or argv[0] in ("-h", "--help"):
        sys.stdout.write(HELP)
        return 0
    try:
        a = p.parse_args(argv)
    except SystemExit:
        print("Run `rouh-app help` for what rouh-app takes.", file=sys.stderr)
        return 2
    if a.verb == "help":
        cmd_help(a)
        return 0
    try:
        if os.geteuid() != 0:
            raise Refused("rouh-app needs root: run it with sudo.")
        os.umask(0o022)
        a.func(a)
        return 0
    except Refused as e:
        print(str(e), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("Stopped.", file=sys.stderr)
        return 130
    except Exception as e:  # a plain sentence, never a traceback the person has to read
        print("rouh-app %s stopped on something it did not expect: %s: %s" % (a.verb, type(e).__name__, e),
              file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
